{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/music-daily/daily5.schema.json",
  "title": "Apple Music Daily 5",
  "type": "object",
  "required": ["schema_version", "date", "provider", "generated_by", "tracks"],
  "properties": {
    "schema_version": {"const": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "provider": {"const": "apple_music"},
    "generated_by": {"type": "string"},
    "obsidian_note": {"type": ["string", "null"]},
    "tracks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["position", "title", "artist", "canonical_id", "apple_music"],
        "properties": {
          "position": {"type": "integer", "minimum": 1, "maximum": 5},
          "title": {"type": "string", "minLength": 1},
          "artist": {"type": "string", "minLength": 1},
          "album": {"type": ["string", "null"]},
          "canonical_id": {"type": "string", "minLength": 1},
          "apple_music": {
            "type": "object",
            "required": ["url", "song_id"],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://music\\.apple\\.com/[A-Za-z]{2}/song/(?:[^/]+/)?[0-9]+(?:[?].*)?$"
              },
              "song_id": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            },
            "additionalProperties": false
          },
          "analysis_summary": {"type": "string"},
          "listening_cue": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
